# Data — raw CSVs stay out of git (see data/README.md for the DVC /
# object-storage migration plan). Docs and .dvc pointer files are kept.
data/**
!data/README.md
!data/**/*.dvc
!data/.gitignore

# Pipeline outputs
outputs/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Notebooks / editors / OS
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/
